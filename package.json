{
  "name": "@leonyuanyaoyao/memstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "memstore": "./dist/cli/main.js",
    "memstore-mcp": "./dist/mcp/main.js"
  },
  "engines": {
    "node": ">=22.17.0 <23",
    "pnpm": ">=10.25.0 <11"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:notifier": "tsx scripts/build-notifier-app.ts",
    "benchmark:retrieval": "tsx scripts/benchmark-retrieval.ts",
    "benchmark:shadow": "tsx scripts/benchmark-shadow-latency.ts",
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"import('node:fs/promises').then(({rm}) => rm('dist', { recursive: true, force: true }))\"",
    "evidence:gate3": "tsx scripts/evidence-gate3.ts",
    "evidence:gate4": "tsx scripts/evidence-gate4.ts",
    "evidence:gate5": "tsx scripts/evidence-gate5.ts",
    "evidence:purge": "tsx scripts/evidence-purge.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "js-tiktoken": "1.0.21",
    "smol-toml": "1.7.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.17.0",
    "eslint": "9.33.0",
    "fast-check": "4.2.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4"
  }
}
